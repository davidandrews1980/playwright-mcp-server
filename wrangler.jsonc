{
  "name": "playwright-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "PlaywrightMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["PlaywrightMCP"]
    }
  ]
}
